Screen {
    layout: vertical;
    background: #0f1115;
}

#shell {
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 4;
    padding: 1 2 0 2;
    background: #111318;
    border-bottom: solid #252a33;
}

#title {
    width: auto;
    max-width: 60;
    margin-right: 1;
    text-style: bold;
    color: #f5f5f5;
    overflow: hidden;
    text-overflow: ellipsis;
}

#run-state {
    width: auto;
    min-width: 0;
    margin-left: 1;
    margin-right: 0;
    text-align: center;
    color: #c6d3e8;
    text-style: bold;
}

#top-throbber {
    width: 1;
    height: 1;
    margin-left: 1;
    margin-right: 0;
    color: #9fd0ff;
    text-align: center;
    content-align: center middle;
    text-style: bold;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #8f95a1;
    overflow: hidden;
    text-overflow: ellipsis;
}

#chat-panel {
    height: 1fr;
}

#conversation {
    height: 1fr;
    padding: 1 4 0 4;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    padding-bottom: 3;
    text-style: bold;
    text-align: center;
    text-wrap: nowrap;
    overflow: hidden;
    padding-left: 2;
    padding-right: 2;
    padding-top: 1;
    padding-bottom: 4;
}

#composer {
    height: 8;
    border: none;
    background: transparent;
    padding: 0 4 0 4;
    align-vertical: bottom;
}

#prompt-container {
    width: 1fr;
    height: auto;
    layout: vertical;
    border: round #2f3b52;
    background: #121826 88%;
    padding: 0 1 0 1;
    margin: 0 1 0 1;
}

.block {
    margin: 0 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: #9caecb;
    text-style: bold;
    margin-bottom: 0;
}

.block.user {
    border: none;
    border-left: solid #4a89d8;
    background: #121a2a 58%;
    padding: 1 2;
    margin-top: 1;
}

.block.assistant {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 0 2 0;
}

.block.assistant .card-title {
    display: none;
}

.block.assistant .card-body {
    margin-top: 0;
    padding: 0 1 0 1;
}

.block.system {
    border: solid #3a424f;
    background: #141922;
}

.block.system.error,
.block.error {
    border: solid #7f1d1d;
    background: #2a1515;
}

.block.tool.running {
    border: none;
    border-left: solid #2a6edb;
    background: #10182a 60%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.success {
    border: none;
    border-left: solid #2f9e63;
    background: #0f1d1a 52%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.tool.error {
    border: none;
    border-left: solid #b23a3a;
    background: #241516 58%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.assistant {
    margin-top: 1;
}


.card-body {
    margin-top: 1;
}

.user-body Markdown,
.assistant-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.user-body MarkdownBlock:last-of-type,
.assistant-body MarkdownBlock:last-of-type {
    margin-bottom: 0;
}

.assistant-body MarkdownFence {
    background: #111a26;
    border: round #2b3a4f;
}

.modal {
    width: 72;
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1 2;
}

ConfirmModal,
PlanQuestionModal,
SessionResumeModal {
    align: center middle;
    background: #06080f 58%;
}

ConfirmModal .confirm-modal {
    width: 76;
    height: auto;
    min-height: 9;
    max-height: 18;
    border: round #3f4c67;
    background: #141b2a 96%;
    padding: 1 2;
}

ConfirmModal .modal-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    margin-top: 1;
}

ConfirmModal #yes,
ConfirmModal #no {
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    text-style: bold;
}

ConfirmModal #yes {
    background: #5dcf84;
    color: #0f1a12;
}

ConfirmModal #yes:hover {
    background: #75de99;
}

ConfirmModal #no {
    background: #2b3243;
    color: #e2e7f2;
}

ConfirmModal #no:hover {
    background: #364058;
}

PlanQuestionModal .plan-modal {
    width: 88;
    height: auto;
    min-height: 12;
    max-height: 30;
    border: round #3f4c67;
    background: #141b2a 96%;
    padding: 1 2;
}

PlanQuestionModal .modal-title {
    text-style: bold;
    color: #c9a6ff;
    margin-bottom: 1;
}

PlanQuestionModal .modal-body {
    color: #dbe3f2;
    margin-bottom: 1;
}

PlanQuestionModal .modal-options {
    margin-bottom: 1;
}

PlanQuestionModal .modal-options Button {
    margin-bottom: 1;
    border: none;
    background: #2b3243;
    color: #e2e7f2;
    text-style: bold;
}

PlanQuestionModal .modal-options Button:hover {
    background: #364058;
}

PlanQuestionModal .modal-options Button.-primary {
    background: #5dcf84;
    color: #0f1a12;
}

PlanQuestionModal .modal-options Button.-primary:hover {
    background: #75de99;
}

PlanQuestionModal #custom-input {
    margin-top: 1;
    margin-bottom: 1;
}

PlanQuestionModal #custom-submit {
    border: none;
    background: #2b3243;
    color: #e2e7f2;
    text-style: bold;
}

PlanQuestionModal #custom-submit:hover {
    background: #364058;
}

SessionResumeModal .modal {
    width: 108;
    height: 32;
    max-height: 86%;
    min-height: 24;
    border: heavy #4f4a70;
    background: #1a2031 96%;
    padding: 1 2;
    overflow: hidden;
}

SessionResumeModal .modal-list {
    height: 1fr;
    min-height: 12;
    max-height: 1fr;
    margin-top: 1;
    margin-bottom: 0;
    border: solid #3b3f58;
    background: #1c2234;
    padding: 0;
    overflow-y: auto;
}

SessionResumeModal .modal-title {
    text-align: center;
    text-style: bold;
    color: #c9a6ff;
    margin-top: 0;
    margin-bottom: 1;
}

SessionResumeModal .modal-body {
    color: #d5d7e2;
    margin-bottom: 1;
}

SessionResumeModal .resume-warning {
    border: round #b38a54;
    background: #2b2833;
    color: #f2ce9a;
    padding: 0 1;
    margin-bottom: 1;
}

SessionResumeModal .modal-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    margin-bottom: 0;
}

SessionResumeModal #resume {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: #b28af3;
    color: #12111a;
    border: none;
}

SessionResumeModal #resume:hover {
    background: #c59df8;
    color: #0f0e16;
}

SessionResumeModal #cancel {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #262b3d;
    color: #e4e6ef;
    border: none;
}

SessionResumeModal #cancel:hover {
    background: #31374d;
}

SessionResumeModal .resume-table {
    height: 1fr;
}

.modal-title {
    text-style: bold;
    color: #f5f5f5;
    margin-bottom: 1;
}

.modal-body {
    color: #d1d5db;
    margin-bottom: 1;
}

.modal-options {
    margin-bottom: 1;
}

.modal-list {
    height: 16;
    margin-top: 1;
    margin-bottom: 1;
    border: solid #334155;
    padding: 1;
}

.modal-actions {
    align-horizontal: right;
    margin-top: 1;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 2;
    border: none;
    background: transparent;
    color: #e5e7eb;
    padding: 1 1 0 1;
}

#prompt:focus {
    border: none;
}

#composer-gap {
    height: 1;
}

#composer-meta {
    height: 3;
    width: 1fr;
    margin: 0 0 0 0;
    align-vertical: middle;
}

.meta-icon {
    width: auto;
    color: #9ca3af;
}

.meta-chip {
    width: auto;
    margin-left: 2;
    color: #d1d5db;
    text-style: bold;
}

#composer-meta .meta-chip:last-of-type {
    margin-right: 2;
}

#meta-spacer {
    width: 1fr;
}

#send {
    width: 9;
    min-width: 9;
    height: 3;
    border: round #e5e7eb;
    background: #ffffff;
    color: #000000;
    text-style: bold;
    margin-right: 1;
    content-align: center middle;
    text-opacity: 100%;
}

#send > .button--label {
    color: #000000;
    text-style: bold;
    text-opacity: 100%;
}

#send:hover {
    background: #ffffff;
    color: #000000;
}

#send:hover > .button--label {
    color: #000000;
}

#send:focus {
    background: #ffffff;
    color: #000000;
}

#send:focus > .button--label {
    color: #000000;
}

Markdown {
    layout: stream;
    background: transparent;
}

MarkdownFence {
    background: #141a24;
    border: round #2f3a4c;
    padding: 0 1;
}

MarkdownTable {
    border: solid #2f3a4c;
}

MarkdownBlockQuote {
    border-left: solid #3f5473;
    background: #151b26;
    padding: 0 1;
}
