Screen {
    layout: vertical;
    background: #0f1115;
}

#shell {
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 4;
    padding: 1 2 0 2;
    background: #111318;
    border-bottom: solid #252a33;
    align-vertical: middle;
}

#session-tabs-scroll {
    height: 3;
    width: 1fr;
    background: #111318;
    border-bottom: solid #252a33;
    overflow-x: auto;
    overflow-y: hidden;
}

#session-tabs {
    height: auto;
    width: auto;
    padding: 0 3 0 3;
    background: transparent;
}

.session-tab {
    width: auto;
    min-width: 12;
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0 1;
    background: #171b22;
    color: #b6c0ce;
    border: none;
}

.session-tab:hover,
.session-tab:focus {
    background: #171b22;
    color: #b6c0ce;
    border: none;
    text-style: none;
}

.session-tab-live {
    background: #3a2410;
    color: #ffd08a;
    text-style: bold;
}

.session-tab-live:hover,
.session-tab-live:focus {
    background: #3a2410;
    color: #ffd08a;
    border: none;
    text-style: bold;
}

.session-tab-live.-primary {
    background: #a85a12;
    color: #fff4df;
    text-style: bold;
}

.session-tab-live.-primary:hover,
.session-tab-live.-primary:focus {
    background: #a85a12;
    color: #fff4df;
    border: none;
    text-style: bold;
}

.session-tab.-primary {
    background: #1f4f92;
    color: #eef5ff;
    text-style: bold;
}

.session-tab.-primary:hover,
.session-tab.-primary:focus {
    background: #1f4f92;
    color: #eef5ff;
    border: none;
    text-style: bold;
}

#title {
    width: auto;
    max-width: 60;
    margin-right: 2;
    text-style: bold;
    color: #f5f5f5;
    overflow: hidden;
    text-overflow: ellipsis;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #8f95a1;
    overflow: hidden;
    text-overflow: ellipsis;
}

#aside-toggle {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: #93f2e8;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#changes-toggle {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: #b8d8ff;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#chat-panel {
    height: 1fr;
}

#chat-body {
    height: 1fr;
    layout: horizontal;
}

#conversation-shell {
    width: 1fr;
    height: 1fr;
}

#change-review-panel {
    width: 104;
    min-width: 84;
    max-width: 136;
    height: 1fr;
    border-right: solid #253544;
    background: #0f1622;
    padding: 1 1 0 1;
    display: none;
}

#change-review-header {
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

#change-review-title {
    width: 1fr;
    color: #b8d8ff;
    text-style: bold;
}

#change-review-close {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0 1;
    background: transparent;
    color: #9caecb;
    border: none;
}

.change-review-action {
    width: auto;
    min-width: 0;
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0 1;
    content-align: center middle;
    text-style: bold;
}

#change-review-stage-all,
#change-review-stage-file {
    color: #8fbfff;
    background: #16263e;
}

#change-review-unstage-file {
    color: #c9d5e8;
    background: #151c28;
}

#change-review-discard-all,
#change-review-discard-file {
    color: #ffcf89;
    background: #33210b;
}

.change-review-action.-disabled {
    color: #5f6d82;
    background: #141922;
}

#change-review-body {
    height: 1fr;
    layout: horizontal;
}

#change-review-tree {
    width: 26;
    min-width: 20;
    height: 1fr;
    border-right: solid #233044;
    padding: 0 0 1 0;
    background: transparent;
}

#change-review-tree:focus {
    background-tint: transparent;
}

#change-review-preview {
    width: 1fr;
    height: 1fr;
    padding: 0 0 1 1;
    background: transparent;
    overflow: auto auto;
}

#change-review-preview-column {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}

#change-review-preview-actions {
    height: 1;
    margin-bottom: 1;
}

.change-review-path {
    color: #d9e6fb;
    text-style: bold;
    margin-bottom: 0;
    width: auto;
}

.change-review-diff {
    width: auto;
    height: auto;
    min-height: 1;
    overflow: auto auto;
    padding: 0;
}

.change-review-empty {
    color: #7f8ea3;
    padding: 1 0;
}

#conversation {
    height: 1fr;
    padding: 1 4 0 4;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    padding-bottom: 3;
    text-style: bold;
    text-align: center;
    text-wrap: nowrap;
    overflow: hidden;
    padding-left: 2;
    padding-right: 2;
    padding-top: 1;
    padding-bottom: 4;
}

#composer {
    height: 8;
    border: none;
    background: transparent;
    padding: 0 4 0 4;
    align-vertical: bottom;
}

#prompt-container {
    width: 1fr;
    height: auto;
    layout: vertical;
    border: round #2f3b52;
    background: #121826 88%;
    padding: 0 1 0 1;
    margin: 0 1 0 1;
}

#aside-panel {
    width: 44;
    min-width: 36;
    height: 1fr;
    border-left: solid #253544;
    background: #10161d;
    padding: 1 1 0 1;
    display: none;
}

#aside-panel-header {
    height: 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#aside-panel-title {
    color: #93f2e8;
    text-style: bold;
}

#aside-panel-body {
    height: 1fr;
    padding: 0;
}

.aside-thread {
    height: auto;
    margin-bottom: 1;
}

.aside-user-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-bottom: 0;
}

.aside-user-entry {
    width: auto;
    max-width: 22;
    min-height: 1;
    margin-left: 14;
    margin-right: 0;
    margin-bottom: 1;
    padding: 0 1;
    border-right: solid #6fb4ff;
    background: #10192a 72%;
    color: #d7e8ff;
    text-align: right;
    content-align: right middle;
}

.aside-assistant-body {
    color: #dfe8ea;
    padding: 0;
    margin-bottom: 1;
    height: auto;
}

.aside-thinking {
    color: #8fdad4;
    text-style: italic;
    padding: 0;
    margin-bottom: 1;
}

.aside-error {
    color: #f29a9a;
    padding: 0;
    margin-bottom: 1;
}

.block {
    margin: 0 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: #9caecb;
    text-style: bold;
    margin-bottom: 0;
}

.block.user {
    border: none;
    border-right: solid #6fb4ff;
    background: #10192a 72%;
    padding: 0 1;
    margin-top: 1;
    margin-left: 26;
    margin-right: 1;
}

.block.user .card-title {
    color: #d7e8ff;
    text-style: bold;
    text-align: right;
    margin-bottom: 0;
    display: none;
}

.block.user .card-body {
    margin-top: 0;
    padding: 1 0 1 1;
}

.block.assistant {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 0 2 0;
}

.block.assistant .card-title {
    display: none;
}

.block.assistant .card-body {
    margin-top: 0;
    padding: 0 1 0 1;
}

.block.system {
    border: solid #3a424f;
    background: #141922;
}

.block.system.error,
.block.error {
    border: solid #7f1d1d;
    background: #2a1515;
}

.block.attachment {
    border: none;
    border-left: solid #4a89d8;
    background: #111827 44%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.block.attachment .card-title {
    color: #9fc5ff;
    text-style: bold;
    margin-bottom: 0;
}

.block.attachment .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.note {
    border: none;
    border-left: solid #4b5568;
    background: #11161f 42%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.block.note .card-title {
    color: #9da9bb;
    text-style: bold;
    margin-bottom: 0;
}

.block.note .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.change {
    border: none;
    border-left: solid #5b7caa;
    background: #101725 58%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.block.change .card-title {
    color: #d9e6fb;
    text-style: bold;
    margin-bottom: 0;
}

.block.change .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.aside {
    border: none;
    border-left: solid #4ecdc4;
    background: #0f1b20 54%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 1;
}

.block.aside .card-title {
    color: #89efe6;
    text-style: bold;
    margin-bottom: 0;
}

.block.aside .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.aside-body {
    layout: vertical;
    height: auto;
}

.aside-meta {
    color: #7bb7b2;
    text-style: bold;
    margin-bottom: 1;
}

.aside-question {
    color: #d7f5f0;
    text-style: italic;
    margin-bottom: 1;
}

.aside-answer {
    color: #dfe8ea;
}

.activity-indicator {
    height: auto;
    min-height: 1;
    background: transparent;
    border: none;
    margin-top: 1;
    margin-bottom: 1;
    padding: 0 1;
    text-style: bold;
}

.block.plan {
    border: none;
    border-left: solid #7c6bd7;
    background: #13172a 46%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan .card-title {
    color: #c9a6ff;
    text-style: bold;
    margin-bottom: 0;
}

.block.plan .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.workboard {
    border: none;
    border-left: solid #7c6bd7;
    background: #13172a 46%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.workboard .card-title {
    color: #c9a6ff;
    text-style: bold;
    margin-bottom: 1;
}

.block.workboard .card-body {
    margin-top: 0;
    padding: 0;
}

.workboard-root {
    layout: vertical;
    height: auto;
}

.workboard-stack {
    layout: vertical;
    height: auto;
}

.workboard-section {
    layout: vertical;
    height: auto;
    border: round #394053;
    background: #0f1420 55%;
    padding: 1 1 1 1;
    margin-bottom: 1;
}

.workboard-section.compact {
    background: #101622 45%;
}

.workboard-section.summary {
    border: round #4f5f80;
    background: #101826 62%;
}

.workboard-section.execution {
    border: round #2f7d57;
    background: #0f1a17 58%;
}

.workboard-section.planning {
    border: round #3476a8;
    background: #0f1720 58%;
}

.workboard-section.plan {
    border: round #7563cf;
    background: #151729 64%;
    margin-top: 1;
}

.workboard-section.muted {
    border: round #394053;
    background: #11161f 42%;
}

.workboard-section-title {
    color: #d7deea;
    text-style: bold;
    margin-bottom: 1;
}

.workboard-section.summary .workboard-section-title {
    color: #b8d8ff;
}

.workboard-section.execution .workboard-section-title {
    color: #91e0b5;
}

.workboard-section.planning .workboard-section-title {
    color: #8fcdf5;
}

.workboard-section.plan .workboard-section-title {
    color: #d7b8ff;
}

.workboard-section Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.workboard-section.plan MarkdownFence {
    background: #121830;
    border: round #3a4368;
}

.workboard-empty {
    color: #98a3b6;
}

.plan-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.plan-body MarkdownFence {
    background: #121830;
    border: round #3a4368;
}

.block.plan.plan-ready {
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan.plan-ready .card-title {
    margin-bottom: 1;
}

.plan-ready-body {
    color: #dbe3f2;
    margin-top: 0;
    margin-bottom: 1;
}

.block.plan.plan-question .card-title {
    margin-bottom: 1;
}

.block.plan.plan-question {
    height: auto;
    min-height: 0;
}

.plan-question-prompt {
    color: #dbe3f2;
    margin-top: 0;
    margin-bottom: 1;
}

.plan-question-options {
    layout: vertical;
    height: auto;
    min-height: 0;
    margin-top: 1;
    margin-bottom: 1;
}

.plan-question-option {
    margin-bottom: 1;
    border: none;
    background: #2b3243;
    color: #e2e7f2;
    text-style: bold;
}

.plan-question-option:hover {
    background: #364058;
}

.plan-question-option.-primary,
.plan-question-option.selected {
    background: #5dcf84;
    color: #0f1a12;
}

.plan-question-option.-primary:hover,
.plan-question-option.selected:hover {
    background: #75de99;
}

.plan-question-custom-row {
    height: auto;
    min-height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#pq-custom-input {
    width: 1fr;
    margin-right: 1;
}

#pq-custom-submit {
    border: none;
    background: #2b3243;
    color: #e2e7f2;
    text-style: bold;
}

#pq-custom-submit:hover {
    background: #364058;
}

.plan-question-status {
    margin-top: 1;
    color: #c8d7f8;
    text-style: bold;
}

.plan-ready-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
}

.plan-ready-actions Button {
    height: 1;
    min-height: 1;
    border: none;
    text-style: bold;
    padding: 0 1;
}

#plan-ready-keep {
    background: #2b3243;
    color: #e2e7f2;
    margin-right: 1;
}

#plan-ready-keep:hover {
    background: #364058;
}

#plan-ready-implement {
    background: #5dcf84;
    color: #0f1a12;
}

#plan-ready-implement:hover {
    background: #75de99;
}

.block.tool.running {
    border: none;
    border-left: solid #2a6edb;
    background: #10182a 60%;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
}

.block.success {
    border: none;
    border-left: solid #2f9e63;
    background: #0f1d1a 52%;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
}

.block.tool.error {
    border: none;
    border-left: solid #b23a3a;
    background: #241516 58%;
    padding: 1 1;
    margin-top: 1;
    margin-bottom: 1;
}

.block.assistant {
    margin-top: 1;
}


.card-body {
    margin-top: 1;
}

.user-body Markdown,
.assistant-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.user-body MarkdownBlock:last-of-type,
.assistant-body MarkdownBlock:last-of-type {
    margin-bottom: 0;
}

.assistant-body MarkdownFence {
    background: #111a26;
    border: round #2b3a4f;
}

.modal {
    width: 72;
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1 2;
}

ConfirmModal,
CommitModal,
PushReviewModal,
RemoteSetupModal,
PlanQuestionModal,
SessionResumeModal,
BranchPickerModal,
AttachPickerModal,
SetupModal {
    align: center middle;
    background: #06080f 58%;
}

ConfirmModal .confirm-modal {
    width: 76;
    height: 12;
    min-height: 12;
    max-height: 16;
    border: heavy #4f4a70;
    background: #1a2031 96%;
    padding: 1 2;
    overflow: hidden;
}

ConfirmModal .confirm-body {
    height: 1fr;
    margin-bottom: 1;
    color: #d5d7e2;
}

ConfirmModal .confirm-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    margin-bottom: 0;
}

ConfirmModal #yes {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: #5dcf84;
    color: #0f1a12;
    border: none;
}

ConfirmModal #yes:hover {
    background: #75de99;
}

ConfirmModal #no {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #2b3243;
    color: #e2e7f2;
    border: none;
}

ConfirmModal #no:hover {
    background: #364058;
}

CommitModal .commit-modal {
    width: 82;
    height: 20;
    min-height: 20;
    max-height: 20;
    border: heavy #4f4a70;
    background: #1a2031 96%;
    padding: 1 2;
    overflow: hidden;
}

CommitModal .commit-body {
    height: 1fr;
    min-height: 12;
}

CommitModal .commit-summary-row,
CommitModal .commit-toggle-row {
    height: 2;
    align-vertical: middle;
}

CommitModal .commit-label {
    width: 18;
    min-width: 18;
    color: #c6d2e3;
    text-style: bold;
}

CommitModal .commit-branch {
    color: #dfe8f8;
    text-style: bold;
}

CommitModal .commit-stats {
    align-vertical: middle;
}

CommitModal .commit-toggle-choice {
    width: auto;
    min-width: 8;
    content-align: left middle;
}

CommitModal .commit-message-label {
    margin-top: 1;
    margin-bottom: 0;
}

CommitModal .commit-message-row {
    height: auto;
    min-height: 3;
    align-vertical: middle;
}

CommitModal #commit-message {
    width: 1fr;
    margin-bottom: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    margin-top: 0;
    margin-right: 1;
}

CommitModal #commit-ai-fill {
    width: 3;
    min-width: 3;
    height: 3;
    min-height: 3;
    margin-left: 0;
    border: none;
    background: #262b3d;
    color: #c9a6ff;
    text-style: bold;
    content-align: center middle;
}

CommitModal #commit-ai-fill:hover {
    background: #31374d;
    color: #dcc0ff;
}

CommitModal .commit-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
}

CommitModal #commit-confirm {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: #b28af3;
    color: #12111a;
    border: none;
}

CommitModal #commit-confirm:hover {
    background: #c59df8;
}

CommitModal #commit-push {
    width: 18;
    min-width: 18;
    text-style: bold;
    background: #5dcf84;
    color: #0f1a12;
    border: none;
}

CommitModal #commit-push:hover {
    background: #75de99;
}

CommitModal #cancel {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #262b3d;
    color: #e4e6ef;
    border: none;
}

CommitModal #cancel:hover {
    background: #31374d;
}

PushReviewModal .push-review-modal {
    width: 88;
    height: auto;
    min-height: 12;
    max-height: 16;
    border: heavy #4f4a70;
    background: #1a2031 96%;
    padding: 1 2;
    overflow: hidden;
}

PushReviewModal .push-review-body {
    height: auto;
    min-height: 6;
    margin-bottom: 1;
}

PushReviewModal .push-review-row {
    height: 2;
    align-vertical: middle;
}

PushReviewModal .push-review-label {
    width: 14;
    min-width: 14;
    color: #c6d2e3;
    text-style: bold;
}

PushReviewModal .push-review-value {
    color: #dfe8f8;
    text-style: bold;
}

PushReviewModal .push-review-warning {
    margin-top: 1;
    margin-bottom: 0;
    color: #f2b38f;
}

RemoteSetupModal .push-review-row {
    height: 2;
    align-vertical: middle;
}

RemoteSetupModal .push-review-label {
    width: 14;
    min-width: 14;
    color: #c6d2e3;
    text-style: bold;
}

RemoteSetupModal .push-review-value {
    color: #dfe8f8;
    text-style: bold;
}

RemoteSetupModal .push-review-warning {
    margin-top: 1;
    margin-bottom: 0;
    color: #f2b38f;
}

PushReviewModal .push-review-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 1;
}

PushReviewModal #cancel {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #262b3d;
    color: #e4e6ef;
    border: none;
}

