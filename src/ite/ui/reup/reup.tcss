}

PlanQuestionModal .plan-modal {
    width: 88;
    height: auto;
    min-height: 12;
    max-height: 30;
    border: round #303236;
    background: #1c1b1d 96%;
    padding: 1 2;
}

PlanQuestionModal .modal-title {
    text-style: bold;
    color: #b7c8e1;
    margin-bottom: 1;
}

PlanQuestionModal .modal-body {
    color: #dfe4ea;
