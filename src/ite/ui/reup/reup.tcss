}

BranchPickerModal .modal {
    width: 108;
    height: 32;
    max-height: 86%;
    min-height: 24;
    border: heavy $border;
    background: $surface;
    padding: 1 2;
    overflow: hidden;
}

ModelPickerModal .modal {
    width: 108;
    height: 32;
