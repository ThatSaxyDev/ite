Screen {
    layout: vertical;
    background: $background;
}

#shell {
    height: 1fr;
    layout: vertical;
    background: $background;
}

#topbar {
    height: 3;
    padding: 0 2 0 2;
    background: $surface;
    align-vertical: middle;
}

#brand-mark {
    width: auto;
    min-width: 8;
    height: 2;
    margin-right: 2;
    padding: 0 2;
    background: #4edea3;
    color: #07140f;
    text-style: bold;
    content-align: center middle;
}

#header-copy {
    width: 1fr;
    height: 2;
    layout: vertical;
}

#brand-kicker {
    width: 1fr;
    color: $text-secondary;
    text-style: bold;
}

#header-actions {
    width: auto;
    height: 2;
    align-vertical: middle;
}

#threads-toggle {
    width: auto;
    min-width: 3;
    height: 1;
    min-height: 1;
    margin-right: 1;
    padding: 0;
    color: $text-primary;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
    display: none;
}

#threads-toggle:hover,
#threads-toggle:focus {
    background: transparent;
    border: none;
    color: $text-secondary;
    text-style: bold;
}

#session-tabs-scroll {
    height: 3;
    width: 1fr;
    background: $surface;
    overflow-x: auto;
    overflow-y: hidden;
}

#session-tabs {
    height: auto;
    width: auto;
    padding: 0 3 0 3;
    background: transparent;
}

.session-tab {
    width: auto;
    min-width: 12;
    height: 3;
    min-height: 3;
    margin-right: 1;
    padding: 0 2;
    background: $panel;
    color: $foreground;
    border: none;
    content-align: center middle;
}

.session-tab:hover,
.session-tab:focus {
    background: $panel-lighten-1;
    color: $foreground;
    border: none;
    text-style: none;
}

.session-tab-live {
    background: $warning-muted;
    color: $text-warning;
    text-style: bold;
}

.session-tab-live:hover,
.session-tab-live:focus {
    background: $warning;
    color: $background;
    border: none;
    text-style: bold;
}

.session-tab-live.-primary {
    background: $success-muted;
    color: $text-success;
    text-style: bold;
}

.session-tab-live.-primary:hover,
.session-tab-live.-primary:focus {
    background: $success;
    color: $background;
    border: none;
    text-style: bold;
}

.session-tab.-primary {
    background: $primary-muted;
    color: $text-primary;
    text-style: bold;
}

.session-tab.-primary:hover,
.session-tab.-primary:focus {
    background: $primary;
    color: $background;
    border: none;
    text-style: bold;
}

#title {
    width: auto;
    max-width: 60;
    margin-right: 2;
    text-style: bold;
    color: $foreground;
    overflow: hidden;
    text-overflow: ellipsis;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: $text-secondary;
    overflow: hidden;
    text-overflow: ellipsis;
}

#aside-toggle {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: $text-success;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#changes-toggle {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: $text-primary;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#chat-panel {
    height: 1fr;
    background: $background;
}

#chat-body {
    height: 1fr;
    layout: horizontal;
    background: $background;
    padding: 0 2 0 2;
}

#conversation-shell {
    width: 1fr;
    min-width: 72;
    height: 1fr;
    background: $background;
}

#change-review-panel {
    split: right;
    width: 48%;
    min-width: 48;
    max-width: 160;
    height: 1fr;
    background: $surface;
    padding: 1 2 0 2;
    border-left: vkey $foreground 30%;
}

#change-review-header {
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

#change-review-title {
    width: 1fr;
    color: $text-primary;
    text-style: bold;
}

#change-review-close {
    width: auto;
    min-width: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border: none;
}

.change-review-action {
    width: auto;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin-right: 1;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}

#change-review-stage-all,
#change-review-stage-file {
    color: $foreground;
    background: $success-muted;
}

#change-review-unstage-file {
    color: $foreground;
    background: $panel;
}

#change-review-discard-all,
#change-review-discard-file {
    color: $foreground;
    background: $warning-muted;
}

.change-review-action.-disabled {
    color: $foreground-muted;
    background: $surface-darken-1;
}

#change-review-body {
    height: 1fr;
    layout: horizontal;
}

#change-review-tree {
    width: 26;
    min-width: 20;
    height: 1fr;
    padding: 0 0 1 0;
    background: $surface;
}

#change-review-tree:focus {
    background-tint: transparent;
}

#change-review-preview {
    width: 1fr;
    height: 1fr;
    padding: 0 0 1 2;
    background: transparent;
    overflow: auto auto;
}

#change-review-preview-column {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}

#change-review-preview-actions {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

.change-review-path {
    color: $foreground;
    text-style: bold;
    margin-bottom: 0;
    width: auto;
}

.change-review-diff {
    width: auto;
    height: auto;
    min-height: 1;
    overflow: auto auto;
    padding: 0;
}

.change-review-empty {
    color: $foreground-muted;
    padding: 1 0;
}

#conversation {
    height: 1fr;
    padding: 1 5 0 5;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    text-style: bold;
    text-align: center;
    text-wrap: wrap;
    overflow: hidden;
    padding: 0 8 0 8;
}

#signed-out-state {
    display: none;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $background;
    padding: 0;
}

#signed-out-stack {
    width: auto;
    height: auto;
    align-horizontal: center;
    align-vertical: middle;
    padding: 0 8;
}

#startup-state {
    display: block;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $background;
    padding: 0;
}

#startup-stack {
    width: auto;
    height: auto;
    align-horizontal: center;
    align-vertical: middle;
    padding: 0 8;
}

#startup-title {
    width: auto;
    text-style: bold;
    color: $text-primary;
    content-align: center middle;
    text-align: center;
}

#startup-copy {
    width: auto;
    max-width: 68;
    margin-top: 1;
    color: $text-secondary;
    content-align: center middle;
    text-align: center;
}

#startup-status {
    width: auto;
    height: 1;
    margin-top: 2;
    color: $text-secondary;
    text-style: bold;
    text-align: center;
}

#signed-out-copy {
    width: auto;
    max-width: 76;
    content-align: center middle;
    text-align: center;
}

#signed-out-status {
    width: auto;
    height: 1;
    margin-top: 2;
    color: $text-secondary;
    text-style: bold;
    text-align: center;
}

#signed-out-actions {
    width: auto;
    height: auto;
    align-horizontal: center;
    align-vertical: middle;
    margin-top: 2;
}

#cloud-sign-in,
#cloud-exit {
    width: 18;
    min-width: 18;
    height: 3;
    margin: 0 1;
    padding: 0 2;
    border: none;
    text-style: bold;
    content-align: center middle;
}

#cloud-sign-in {
    background: $primary;
    color: $button-color-foreground;
}

#cloud-sign-in:hover,
#cloud-sign-in:focus {
    background: $primary-lighten-1;
    color: $button-color-foreground;
}

#cloud-sign-in:disabled {
    background: $panel;
    color: $foreground-disabled;
}

#cloud-exit {
    background: $panel;
    color: $foreground;
}

#cloud-exit:hover,
#cloud-exit:focus {
    background: $panel-lighten-1;
    color: $foreground;
}

#onboarding-state {
    display: none;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $background;
    padding: 0;
}

#onboarding-stack {
    width: 72;
    max-width: 84;
    height: auto;
    align-horizontal: center;
    align-vertical: middle;
    padding: 0 4;
}

#onboarding-title {
    width: 100%;
    text-style: bold;
    color: $text-primary;
    content-align: center middle;
    text-align: center;
}

#onboarding-copy {
    width: 100%;
    margin-top: 1;
    margin-bottom: 1;
    color: $text-secondary;
    content-align: center middle;
    text-align: center;
}

#onboarding-name,
#onboarding-role-select,
#onboarding-role-other,
#onboarding-use-case-select,
#onboarding-use-case-other {
    width: 100%;
    margin-top: 1;
    background: $surface-darken-1;
    color: $foreground;
    border: round $border;
}

#onboarding-role-other,
#onboarding-use-case-other {
    display: none;
}

#onboarding-actions {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 2;
}

#onboarding-skip,
#onboarding-continue {
    width: 16;
    min-width: 16;
    height: 3;
    margin-left: 1;
    padding: 0 2;
    border: none;
    text-style: bold;
    content-align: center middle;
}

#onboarding-skip {
    background: $panel;
    color: $foreground;
}

#onboarding-skip:hover,
#onboarding-skip:focus {
    background: $panel-lighten-1;
    color: $foreground;
}

#onboarding-continue {
    background: $primary;
    color: $button-color-foreground;
}

#onboarding-continue:hover,
#onboarding-continue:focus {
    background: $primary-lighten-1;
    color: $button-color-foreground;
}

#onboarding-status {
    width: 100%;
    height: 1;
    margin-top: 2;
    color: $text-secondary;
    text-style: bold;
    text-align: center;
}

#composer {
    height: 8;
    border: none;
    background: transparent;
    padding: 0 4 0 4;
    align-vertical: bottom;
}

#prompt-container {
    width: 1fr;
    height: auto;
    layout: vertical;
    border: round $border;
    background: $surface;
    padding: 0 1 0 1;
    margin: 0 1 0 1;
}

#prompt-kicker {
    display: none;
}

#aside-panel {
    width: 44;
    min-width: 36;
    height: 1fr;
    background: $surface;
    padding: 1 2 0 2;
    display: none;
}

#aside-panel-header {
    height: 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#aside-panel-title {
    color: $text-success;
    text-style: bold;
}

#aside-panel-body {
    height: 1fr;
    padding: 0;
}

#commands-panel {
    split: left;
    width: 48%;
    min-width: 48;
    max-width: 84;
    height: 1fr;
    background: $surface;
    border-right: vkey $foreground 30%;
    padding: 0 1;
    padding-left: 1;
    layout: vertical;
}

#commands-panel .commands-panel-header {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

#commands-panel .commands-panel-title {
    width: 1fr;
    color: $text-primary;
    text-style: bold;
}

#commands-panel .commands-panel-close {
    width: auto;
    min-width: 8;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $foreground;
}

#commands-panel .commands-panel-close:hover {
    background: $panel-lighten-1;
    color: $text-primary;
}

#commands-panel .commands-panel-close:focus {
    background: $primary;
    color: $text-primary;
}

#commands-panel .commands-panel-subtitle {
    color: $foreground-muted;
    margin-bottom: 1;
}

#commands-panel .commands-panel-table {
    width: 1fr;
    height: 1fr;
}

#thread-switcher-panel {
    split: left;
    width: 30;
    min-width: 24;
    max-width: 36;
    height: 1fr;
    background: $surface;
    border-right: vkey $foreground 30%;
    padding: 0 1;
    padding-left: 1;
    layout: vertical;
}

#thread-switcher-panel .thread-switcher-header {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

#thread-switcher-panel .thread-switcher-title {
    width: 1fr;
    color: $text-primary;
    text-style: bold;
}

#thread-switcher-panel .thread-switcher-close {
    width: auto;
    min-width: 8;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $foreground;
}

#thread-switcher-panel .thread-switcher-close:hover {
    background: $panel-lighten-1;
    color: $text-primary;
}

#thread-switcher-panel .thread-switcher-close:focus {
    background: $primary;
    color: $text-primary;
}

#thread-switcher-panel .thread-switcher-new-chat {
    width: 1fr;
    min-height: 3;
    height: 3;
    margin-bottom: 1;
    padding: 0 2;
    border: none;
    background: $panel;
    color: $text-primary;
    text-style: bold;
    content-align: center middle;
}

#thread-switcher-panel .thread-switcher-new-chat:hover,
#thread-switcher-panel .thread-switcher-new-chat:focus {
    background: $panel-lighten-1;
    border: none;
    color: $text-primary;
    text-style: bold;
    margin-bottom: 1;
}

#thread-switcher-panel .thread-switcher-list {
    width: 1fr;
    height: 1fr;
}

#thread-switcher-panel .thread-switcher-item {
    width: 1fr;
    min-height: 1;
    height: 1;
    margin-bottom: 1;
    padding: 0;
    border: none;
    background: transparent;
    color: $foreground;
    content-align: left middle;
    overflow: hidden;
    text-overflow: ellipsis;
}

#thread-switcher-panel .thread-switcher-item:hover,
#thread-switcher-panel .thread-switcher-item:focus {
    background: transparent;
    color: $text-primary;
    border: none;
    text-style: bold;
}

#thread-switcher-panel .thread-switcher-item.current {
    background: transparent;
    color: $text-primary;
    text-style: bold;
}

#thread-switcher-panel .thread-switcher-item.live {
    background: transparent;
    color: $text-warning;
    text-style: bold;
}

.aside-thread {
    height: auto;
    margin-bottom: 1;
}

.aside-user-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-bottom: 0;
}

.aside-user-entry {
    width: auto;
    max-width: 22;
    min-height: 1;
    margin-left: 14;
    margin-right: 0;
    margin-bottom: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    text-align: right;
    content-align: right middle;
}

.aside-assistant-body {
    color: $foreground;
    padding: 0;
    margin-bottom: 1;
    height: auto;
}

.aside-thinking {
    color: $foreground-muted;
    text-style: italic;
    padding: 0;
    margin-bottom: 1;
}

.aside-error {
    color: $text-error;
    padding: 0;
    margin-bottom: 1;
}

.block {
    margin: 0 0 2 0;
    padding: 0;
    border: none;
    background: transparent;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: $text-secondary;
    text-style: bold;
    margin-bottom: 1;
}

.chat-user-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 0 0 2 0;
    padding: 0;
}

.chat-user-bubble {
    width: auto;
    max-width: 92;
    min-height: 1;
    margin-left: 8;
    margin-right: 2;
    padding: 1 1;
    background: $panel;
    color: $foreground;
    text-align: right;
    content-align: right middle;
}

.block.assistant {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 4 2 0;
}

.block.assistant .card-title {
    display: none;
}

.block.assistant .card-body {
    margin-top: 0;
    padding: 0 2 0 0;
}

.block.system {
    border: round $border;
    background: $surface;
}

.block.system .remote-bridge-card {
    width: 1fr;
    height: auto;
    padding-top: 1;
}

.block.system .remote-bridge-intro {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 1;
}

.block.system .remote-bridge-field {
    width: 1fr;
    height: auto;
    min-height: 3;
    border: round $border;
    background: $surface-darken-1;
    padding: 0 1;
    margin-bottom: 1;
}

.block.system .remote-bridge-field.emph {
    border: round $primary;
    background: $primary-muted;
}

.block.system .remote-bridge-field.wide {
    width: 1fr;
}

.block.system .remote-bridge-field-label {
    width: 16;
    padding-right: 2;
    color: $foreground-muted;
    text-style: bold;
    content-align: left middle;
}

.block.system .remote-bridge-copy {
    min-width: 8;
    width: auto;
    height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $foreground;
}

.block.system .remote-bridge-copy:hover {
    background: $panel-lighten-1;
    color: $text-primary;
}

.block.system .remote-bridge-copy:focus {
    background: $primary;
    color: $text-primary;
}

.block.system .remote-bridge-field-value {
    width: 1fr;
    height: auto;
    color: $foreground;
    content-align: left middle;
}

.block.system .remote-bridge-footer {
    height: auto;
    color: $foreground-muted;
    margin-top: 1;
}

.block.system.error,
.block.error {
    border: round $warning;
    background: $warning-muted;
}

.block.attachment {
    border: round $border;
    background: $surface;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.attachment .card-title {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 0;
}

.block.attachment .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.note {
    border: round $border;
    background: $surface;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.note .card-title {
    color: $foreground-muted;
    text-style: bold;
    margin-bottom: 0;
}

.block.note .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.recovery {
    border: round $warning;
    background: $warning-muted;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.recovery .card-title {
    color: $text-warning;
    text-style: bold;
    margin-bottom: 0;
}

.block.recovery .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
    color: $foreground;
}

.block.command {
    border: none;
    background: $panel;
    padding: 1 2 1 2;
    margin: 0 2 2 0;
}

.block.command.command-error {
    background: $warning-muted;
}

.block.command .card-title {
    color: $foreground-muted;
    text-style: none;
    margin-bottom: 1;
}

.block.command .card-body {
    margin-top: 0;
    padding: 0;
}

.command-title-row {
    width: 1fr;
    height: auto;
    align-vertical: middle;
}

.command-kicker {
    width: auto;
    margin-right: 2;
    padding: 0 1;
    background: $primary-muted;
    color: $text-primary;
    text-style: bold;
}

.block.command.command-error .command-kicker {
    background: $error-muted;
    color: $text-error;
}

.command-name {
    width: 1fr;
    color: $text-primary;
    text-style: bold;
}

.command-body {
    color: $foreground;
}

.command-body Markdown {
    color: $foreground;
}

.command-body Markdown H1,
.command-body Markdown H2,
.command-body Markdown H3,
.command-body Markdown Strong {
    color: $foreground;
}

.command-body MarkdownFence {
    background: $surface-darken-1;
    border: round $border;
}

.command-body MarkdownBlockQuote {
    border-left: solid $border;
    background: $surface-darken-1;
}

.block.skills {
    border: none;
    background: $surface;
    padding: 1 2;
    margin: 0 2 2 0;
}

.block.skills .card-title {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 0;
}

.block.skills .card-body {
    margin-top: 1;
    padding: 0;
}

.block.change {
    border: round $border;
    background: $surface;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.change .card-title {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 0;
}

.block.change .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.aside {
    border: round $border;
    background: $panel;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.aside .card-title {
    color: $text-success;
    text-style: bold;
    margin-bottom: 0;
}

.block.aside .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.aside-body {
    layout: vertical;
    height: auto;
}

.aside-meta {
    color: $text-success;
    text-style: bold;
    margin-bottom: 1;
}

.aside-question {
    color: $foreground;
    text-style: italic;
    margin-bottom: 1;
}

.aside-answer {
    color: $foreground;
}

.activity-indicator {
    height: auto;
    min-height: 1;
    background: transparent;
    border: none;
    margin-top: 0;
    margin-bottom: 2;
    padding: 0 1;
    text-style: bold;
}

.block.plan {
    border: round $border;
    background: $surface-darken-1;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan .card-title {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 0;
}

.block.plan .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.workboard {
    border: round $border;
    background: $surface;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.workboard .card-title {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 1;
}

.block.workboard .card-body {
    margin-top: 0;
    padding: 0;
}

.workboard-root {
    layout: vertical;
    height: auto;
}

.workboard-stack {
    layout: vertical;
    height: auto;
}

.workboard-section {
    layout: vertical;
    height: auto;
    border: round $border;
    background: $surface-darken-1;
    padding: 1 1 1 1;
    margin-bottom: 1;
}

.workboard-section.compact {
    background: $panel;
}

.workboard-section.summary {
    border: round $border;
    background: $surface-darken-1;
}

.workboard-section.execution {
    border: round $success-muted;
    background: $surface-darken-1;
}

.workboard-section.planning {
    border: round $primary-muted;
    background: $surface-darken-1;
}

.workboard-section.plan {
    border: round $border;
    background: $surface-darken-1;
    margin-top: 1;
}

.workboard-section.muted {
    border: round $border;
    background: $panel;
}

.workboard-section-title {
    color: $foreground;
    text-style: bold;
    margin-bottom: 1;
}

.workboard-section.summary .workboard-section-title {
    color: $text-primary;
}

.workboard-section.execution .workboard-section-title {
    color: $text-success;
}

.workboard-section.planning .workboard-section-title {
    color: $text-primary;
}

.workboard-section.plan .workboard-section-title {
    color: $text-primary;
}

.workboard-section Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
    color: $foreground;
}

.workboard-section MarkdownParagraph,
.workboard-section MarkdownList,
.workboard-section MarkdownTable,
.workboard-section MarkdownBlockQuote,
.workboard-section MarkdownStrong,
.workboard-section MarkdownEm {
    color: $foreground;
}

.workboard-section.plan MarkdownFence {
    background: $surface-darken-1;
    border: round $border;
}

.workboard-empty {
    color: $foreground-muted;
}

.plan-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.plan-body MarkdownFence {
    background: #0e0e10;
    border: round #303236;
}

.block.plan.plan-ready {
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan.plan-ready .card-title {
    margin-bottom: 1;
}

.plan-ready-body {
    margin-top: 0;
    margin-bottom: 1;
}

.block.plan.plan-question .card-title {
    margin-bottom: 1;
}

.block.plan.plan-question {
    height: auto;
    min-height: 0;
}

.plan-question-prompt {
    margin-top: 0;
    margin-bottom: 1;
}

.plan-question-options {
    layout: vertical;
    height: auto;
    min-height: 0;
    margin-top: 1;
    margin-bottom: 1;
}

.plan-question-option {
    margin-bottom: 1;
    border: none;
    background: $surface-darken-1;
    color: $foreground;
    text-style: bold;
}

.plan-question-option:hover {
    background: $surface;
}

.plan-question-option.-primary,
.plan-question-option.selected {
    background: $success;
    color: $text-primary;
}

.plan-question-option.-primary:hover,
.plan-question-option.selected:hover {
    background: $success-lighten-1;
}

.plan-question-custom-row {
    height: auto;
    min-height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#pq-custom-input {
    width: 1fr;
    margin-right: 1;
}

#pq-custom-submit {
    border: none;
    background: $surface-darken-1;
    color: $foreground;
    text-style: bold;
}

#pq-custom-submit:hover {
    background: $surface;
}

.plan-question-status {
    margin-top: 1;
    color: $foreground-muted;
    text-style: bold;
}

.plan-ready-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
}

.plan-ready-actions Button {
    height: 1;
    min-height: 1;
    border: none;
    text-style: bold;
    padding: 0 1;
}

#plan-ready-keep {
    background: #2a2a2c;
    color: #edf1f7;
    margin-right: 1;
}

#plan-ready-keep:hover {
    background: #313337;
}

#plan-ready-implement {
    background: #4edea3;
    color: #07140f;
}

#plan-ready-implement:hover {
    background: #6ae7b5;
}

.block.tool.running {
    border: none;
    background: $surface;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.tool.mcp-card {
    background: $surface;
    padding: 1 2;
}

.block.success {
    border: none;
    background: $surface;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.tool.error {
    border: none;
    background: $warning-muted;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.shell-card {
    background: $surface;
    padding: 1 2;
    margin-top: 0;
    margin-bottom: 2;
    layout: vertical;
    height: auto;
    min-height: 12;
}

.shell-card-header {
    color: $text-primary;
    text-style: bold;
    margin-bottom: 1;
}

.shell-card-scroll {
    height: auto;
    max-height: 18;
    min-height: 8;
    overflow-y: auto;
}

/* Streaming command card scrollable body */
.command-card-scroll {
    height: auto;
    max-height: 20;
    min-height: 2;
    overflow-y: auto;
}

.shell-card-body {
    color: $foreground;
}

.block.assistant {
    margin-top: 1;
}


.card-body {
    margin-top: 1;
}

.user-body Markdown,
.assistant-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.assistant-body MarkdownParagraph,
.assistant-body MarkdownList,
.assistant-body MarkdownTable,
.assistant-body MarkdownBlockQuote {
    color: $foreground;
}

.assistant-body MarkdownH1 {
    color: $markdown-h1-color;
    background: transparent;
    text-style: bold;
}

.assistant-body MarkdownH2 {
    color: $markdown-h2-color;
    background: transparent;
    text-style: bold;
}

.assistant-body MarkdownH3 {
    color: $markdown-h3-color;
    background: transparent;
    text-style: bold;
}

.assistant-body MarkdownH4,
.assistant-body MarkdownH5,
.assistant-body MarkdownH6 {
    color: $foreground;
    background: transparent;
    text-style: bold;
}

.assistant-body MarkdownTableContent > .header {
    color: $text-primary;
}

.user-body MarkdownBlock:last-of-type,
.assistant-body MarkdownBlock:last-of-type {
    margin-bottom: 0;
}

.assistant-body MarkdownFence {
    background: $surface-darken-1;
    border: round $border;
}

.modal {
    width: 72;
    height: auto;
    border: round $border;
    background: $surface;
    padding: 1 2;
}

ConfirmModal,
CommitModal,
PushReviewModal,
RemoteSetupModal,
PlanQuestionModal,
SessionResumeModal,
BranchPickerModal,
ModelPickerModal,
ThemePickerModal,
ApprovalPickerModal,
UsageSummaryModal,
ContextSummaryModal,
ActivityModal,
AttachPickerModal,
SetupModal {
    align: center middle;
    background: $background-darken-1 62%;
}

ConfirmModal .confirm-modal {
    width: 76;
    height: 12;
    min-height: 12;
    max-height: 16;
    border: heavy $border;
    background: $surface;
    padding: 1 2;
    overflow: hidden;
}

ConfirmModal .confirm-body {
    height: 1fr;
    margin-bottom: 1;
    color: $foreground;
}

ConfirmModal .confirm-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    margin-bottom: 0;
}

ConfirmModal .confirm-primary {
    width: auto;
    min-width: 16;
    text-style: bold;
    background: #4edea3;
    color: #07140f;
    border: none;
}

ConfirmModal .confirm-primary:hover {
    background: #6ae7b5;
}

ConfirmModal .confirm-secondary {
    width: auto;
    min-width: 16;
    text-style: bold;
    background: #2a2a2c;
    color: #edf1f7;
    border: none;
}

ConfirmModal .confirm-secondary:hover {
    background: #313337;
}

CommitModal .commit-modal {
    width: 82;
    height: 20;
    min-height: 20;
    max-height: 20;
    border: heavy $border;
    background: $surface;
    padding: 1 2;
    overflow: hidden;
}

CommitModal .commit-body {
    height: 1fr;
    min-height: 12;
}

CommitModal .commit-summary-row,
CommitModal .commit-toggle-row {
    height: 2;
    align-vertical: middle;
}

CommitModal .commit-label {
    width: 18;
    min-width: 18;
    color: $foreground-muted;
    text-style: bold;
}

CommitModal .commit-branch {
    color: $foreground;
    text-style: bold;
}

CommitModal .commit-stats {
    align-vertical: middle;
}

CommitModal .commit-toggle-choice {
    width: auto;
    min-width: 8;
    content-align: left middle;
}

CommitModal .commit-message-header {
    height: 1;
    min-height: 1;
    align-vertical: middle;
    margin-top: 1;
    margin-bottom: 1;
}

CommitModal .commit-message-label {
    margin-top: 0;
    margin-bottom: 0;
}

CommitModal .commit-message-row {
    height: auto;
    min-height: 3;
    align-vertical: middle;
    margin-bottom: 0;
}

CommitModal #commit-message {
    width: 1fr;
    margin-bottom: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    margin-top: 0;
    margin-right: 1;
}

CommitModal #commit-ai-fill {
    width: 3;
    min-width: 3;
    height: 3;
    min-height: 3;
    margin-left: 0;
    border: none;
    background: $panel;
    color: $text-primary;
    text-style: bold;
    content-align: center middle;
}

CommitModal #commit-ai-fill:hover {
    background: $panel-lighten-1;
    color: $text-primary;
}

CommitModal .commit-ai-status {
    width: 1fr;
    height: 1;
    min-height: 1;
    margin-left: 1;
    margin-top: 0;
    margin-bottom: 0;
    color: $foreground-muted;
    content-align: left middle;
}

CommitModal .commit-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
}

CommitModal #commit-confirm {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: $primary;
    color: $button-color-foreground;
    border: none;
}

CommitModal #commit-confirm:hover {
    background: $primary-lighten-1;
    color: $button-color-foreground;
}

CommitModal #commit-push {
    width: 18;
    min-width: 18;
    text-style: bold;
    background: $success;
    color: $button-color-foreground;
    border: none;
}

CommitModal #commit-push:hover {
    background: $success-lighten-1;
    color: $button-color-foreground;
}

CommitModal #cancel {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: $panel;
    color: $foreground;
    border: none;
}

CommitModal #cancel:hover {
    background: $panel-lighten-1;
}

PushReviewModal .push-review-modal {
