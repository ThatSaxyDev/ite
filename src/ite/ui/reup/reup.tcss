Screen {
    layout: vertical;
    background: #121212;
}

#shell {
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 3;
    padding: 0 2;
    background: #1a1a1a;
    border-bottom: solid #2a2a2a;
}

#title {
    width: auto;
    text-style: bold;
    color: #f5f5f5;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #9ca3af;
}

#conversation {
    height: 1fr;
    padding: 1 2;
}

#composer {
    height: 11;
    border-top: solid #2a2a2a;
    background: #171717;
    padding: 1 2;
}

#prompt {
    width: 1fr;
    height: 100%;
    border: solid #2f2f2f;
}

#composer-actions {
    width: 16;
    height: 100%;
    padding-left: 1;
}

.block {
    margin: 0 0 1 0;
    padding: 1;
    border: solid #303030;
    background: #1c1c1c;
    height: auto;
}

.block .card-title {
    color: #a8d3ff;
    text-style: bold;
    margin-bottom: 1;
}

.block.user {
    border: solid #3a3a3a;
    background: #202020;
}

.block.assistant {
    border: solid #34506f;
}

.block.system {
    border: solid #4a4a4a;
    background: #191919;
}

.block.system.error,
.block.error {
    border: solid #7f1d1d;
    background: #2a1515;
}

.block.tool.running {
    border: solid #1d4ed8;
}

.block.success {
    border: solid #166534;
}

.modal {
    width: 72;
    height: auto;
    border: round #3d3d3d;
    background: #181818;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #f5f5f5;
    margin-bottom: 1;
}

.modal-body {
    color: #d1d5db;
    margin-bottom: 1;
}

.modal-options {
    margin-bottom: 1;
}

.modal-actions {
    align-horizontal: right;
    margin-top: 1;
}
