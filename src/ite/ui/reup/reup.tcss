Screen {
    layout: vertical;
    background: #131315;
}

#shell {
    height: 1fr;
    layout: vertical;
    background: #131315;
}

#topbar {
    height: 3;
    padding: 0 2 0 2;
    background: #1c1b1d;
    align-vertical: middle;
}

#brand-mark {
    width: auto;
    min-width: 8;
    height: 2;
    margin-right: 2;
    padding: 0 2;
    background: #4edea3;
    color: #07140f;
    text-style: bold;
    content-align: center middle;
}

#header-copy {
    width: 1fr;
    height: 2;
    layout: vertical;
}

#brand-kicker {
    width: 1fr;
    color: #7d8591;
    text-style: bold;
}

#header-actions {
    width: auto;
    height: 2;
    align-vertical: middle;
}

#session-tabs-scroll {
    height: 3;
    width: 1fr;
    background: #18181b;
    overflow-x: auto;
    overflow-y: hidden;
}

#session-tabs {
    height: auto;
    width: auto;
    padding: 0 3 0 3;
    background: transparent;
}

.session-tab {
    width: auto;
    min-width: 12;
    height: 3;
    min-height: 3;
    margin-right: 1;
    padding: 0 2;
    background: #232327;
    color: #c6cbd4;
    border: none;
    content-align: center middle;
}

.session-tab:hover,
.session-tab:focus {
    background: #2a2a2c;
    color: #edf1f7;
    border: none;
    text-style: none;
}

.session-tab-live {
    background: #2f2419;
    color: #ffcf92;
    text-style: bold;
}

.session-tab-live:hover,
.session-tab-live:focus {
    background: #3a2b1c;
    color: #ffe3b8;
    border: none;
    text-style: bold;
}

.session-tab-live.-primary {
    background: #1f3a2f;
    color: #eefcf6;
    text-style: bold;
}

.session-tab-live.-primary:hover,
.session-tab-live.-primary:focus {
    background: #254437;
    color: #f5fffb;
    border: none;
    text-style: bold;
}

.session-tab.-primary {
    background: #25313d;
    color: #eef3f8;
    text-style: bold;
}

.session-tab.-primary:hover,
.session-tab.-primary:focus {
    background: #2d3a46;
    color: #f7f9fc;
    border: none;
    text-style: bold;
}

#title {
    width: auto;
    max-width: 60;
    margin-right: 2;
    text-style: bold;
    color: #f2f5f8;
    overflow: hidden;
    text-overflow: ellipsis;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #8f95a1;
    overflow: hidden;
    text-overflow: ellipsis;
}

#aside-toggle {
    width: auto;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: #93f2e8;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#changes-toggle {
    width: auto;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 2;
    padding: 0;
    color: #b8d8ff;
    text-style: bold;
    background: transparent;
    border: none;
    content-align: center middle;
}

#chat-panel {
    height: 1fr;
    background: #131315;
}

#chat-body {
    height: 1fr;
    layout: horizontal;
    background: #131315;
    padding: 0 2 0 2;
}

#conversation-shell {
    width: 11fr;
    min-width: 72;
    height: 1fr;
    background: #131315;
}

#change-review-panel {
    width: 9fr;
    min-width: 72;
    height: 1fr;
    background: #1c1b1d;
    padding: 1 2 0 2;
    display: none;
}

#change-review-header {
    height: auto;
    margin-bottom: 1;
    align-vertical: middle;
}

#change-review-title {
    width: 1fr;
    color: #b7c8e1;
    text-style: bold;
}

#change-review-close {
    width: auto;
    min-width: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    background: #2a2a2c;
    color: #c6c6cd;
    border: none;
}

.change-review-action {
    width: auto;
    min-width: 0;
    height: 3;
    min-height: 3;
    margin-right: 1;
    padding: 0 2;
    content-align: center middle;
    text-style: bold;
}

#change-review-stage-all,
#change-review-stage-file {
    color: #07140f;
    background: #4edea3;
}

#change-review-unstage-file {
    color: #e3e7ee;
    background: #2a2a2c;
}

#change-review-discard-all,
#change-review-discard-file {
    color: #1a1207;
    background: #ffb95f;
}

.change-review-action.-disabled {
    color: #626875;
    background: #202125;
}

#change-review-body {
    height: 1fr;
    layout: horizontal;
}

#change-review-tree {
    width: 26;
    min-width: 20;
    height: 1fr;
    padding: 0 0 1 0;
    background: #18181b;
}

#change-review-tree:focus {
    background-tint: transparent;
}

#change-review-preview {
    width: 1fr;
    height: 1fr;
    padding: 0 0 1 2;
    background: transparent;
    overflow: auto auto;
}

#change-review-preview-column {
    width: 1fr;
    height: 1fr;
    padding-left: 1;
}

#change-review-preview-actions {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    align-vertical: middle;
}

.change-review-path {
    color: #edf1f7;
    text-style: bold;
    margin-bottom: 0;
    width: auto;
}

.change-review-diff {
    width: auto;
    height: auto;
    min-height: 1;
    overflow: auto auto;
    padding: 0;
}

.change-review-empty {
    color: #8c93a1;
    padding: 1 0;
}

#conversation {
    height: 1fr;
    padding: 1 5 0 5;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    text-style: bold;
    text-align: center;
    text-wrap: wrap;
    overflow: hidden;
    padding: 0 8 0 8;
}

#composer {
    height: 8;
    border: none;
    background: transparent;
    padding: 0 4 0 4;
    align-vertical: bottom;
}

#prompt-container {
    width: 1fr;
    height: auto;
    layout: vertical;
    border: round #303236;
    background: #1f2226 82%;
    padding: 0 1 0 1;
    margin: 0 1 0 1;
}

#prompt-kicker {
    display: none;
}

#aside-panel {
    width: 44;
    min-width: 36;
    height: 1fr;
    background: #191c1f;
    padding: 1 2 0 2;
    display: none;
}

#aside-panel-header {
    height: 1;
    margin-bottom: 1;
    align-vertical: middle;
}

#aside-panel-title {
    color: #4edea3;
    text-style: bold;
}

#aside-panel-body {
    height: 1fr;
    padding: 0;
}

.aside-thread {
    height: auto;
    margin-bottom: 1;
}

.aside-user-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-bottom: 0;
}

.aside-user-entry {
    width: auto;
    max-width: 22;
    min-height: 1;
    margin-left: 14;
    margin-right: 0;
    margin-bottom: 1;
    padding: 0 1;
    background: #232327 88%;
    color: #edf1f7;
    text-align: right;
    content-align: right middle;
}

.aside-assistant-body {
    color: #dfe4ea;
    padding: 0;
    margin-bottom: 1;
    height: auto;
}

.aside-thinking {
    color: #7fd4b0;
    text-style: italic;
    padding: 0;
    margin-bottom: 1;
}

.aside-error {
    color: #f1a4a4;
    padding: 0;
    margin-bottom: 1;
}

.block {
    margin: 0 0 2 0;
    padding: 0;
    border: none;
    background: transparent;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: #8c93a1;
    text-style: bold;
    margin-bottom: 1;
}

.chat-user-row {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin: 0 0 2 0;
    padding: 0;
}

.chat-user-bubble {
    width: auto;
    max-width: 92;
    min-height: 1;
    margin-left: 8;
    margin-right: 2;
    padding: 1 1;
    background: #202226 96%;
    color: #edf1f7;
    text-align: right;
    content-align: right middle;
}

.block.assistant {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 4 2 0;
}

.block.assistant .card-title {
    display: none;
}

.block.assistant .card-body {
    margin-top: 0;
    padding: 0 2 0 0;
}

.block.system {
    border: round #303236;
    background: #1d1f23 82%;
}

.block.system.error,
.block.error {
    border: round #5a4633;
    background: #261f1a 88%;
}

.block.attachment {
    border: round #303236;
    background: #1d1f23 84%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.attachment .card-title {
    color: #b7c8e1;
    text-style: bold;
    margin-bottom: 0;
}

.block.attachment .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.note {
    border: round #303236;
    background: #1d1f23 84%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.note .card-title {
    color: #c6c6cd;
    text-style: bold;
    margin-bottom: 0;
}

.block.note .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.command {
    border: none;
    background: #181a1d 78%;
    padding: 1 2;
    margin: 0 3 2 0;
}

.block.command .card-title {
    color: #b7c8e1;
    text-style: bold;
    margin-bottom: 0;
}

.block.command .card-body {
    margin-top: 1;
    padding: 0;
}

.block.skills {
    border: none;
    background: #1b1d20 84%;
    padding: 1 2;
    margin: 0 2 2 0;
}

.block.skills .card-title {
    color: #edf1f7;
    text-style: bold;
    margin-bottom: 0;
}

.block.skills .card-body {
    margin-top: 1;
    padding: 0;
}

.block.change {
    border: round #303236;
    background: #1d1f23 84%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.change .card-title {
    color: #edf1f7;
    text-style: bold;
    margin-bottom: 0;
}

.block.change .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.aside {
    border: round #32443d;
    background: #1b201e 84%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.aside .card-title {
    color: #4edea3;
    text-style: bold;
    margin-bottom: 0;
}

.block.aside .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.aside-body {
    layout: vertical;
    height: auto;
}

.aside-meta {
    color: #7cc9ad;
    text-style: bold;
    margin-bottom: 1;
}

.aside-question {
    color: #e4faf1;
    text-style: italic;
    margin-bottom: 1;
}

.aside-answer {
    color: #dfe4ea;
}

.activity-indicator {
    height: auto;
    min-height: 1;
    background: transparent;
    border: none;
    margin-top: 0;
    margin-bottom: 2;
    padding: 0 1;
    text-style: bold;
}

.block.plan {
    border: round #353942;
    background: #1d1f23 84%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan .card-title {
    color: #b7c8e1;
    text-style: bold;
    margin-bottom: 0;
}

.block.plan .card-body {
    margin-top: 1;
    padding: 0 1 0 1;
}

.block.workboard {
    border: round #303236;
    background: #1d1f23 86%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.workboard .card-title {
    color: #b7c8e1;
    text-style: bold;
    margin-bottom: 1;
}

.block.workboard .card-body {
    margin-top: 0;
    padding: 0;
}

.workboard-root {
    layout: vertical;
    height: auto;
}

.workboard-stack {
    layout: vertical;
    height: auto;
}

.workboard-section {
    layout: vertical;
    height: auto;
    border: round #303236;
    background: #16181c 68%;
    padding: 1 1 1 1;
    margin-bottom: 1;
}

.workboard-section.compact {
    background: #17191d 58%;
}

.workboard-section.summary {
    border: round #3b4047;
    background: #171b21 76%;
}

.workboard-section.execution {
    border: round #2d4940;
    background: #151c19 74%;
}

.workboard-section.planning {
    border: round #37424c;
    background: #171b21 74%;
}

.workboard-section.plan {
    border: round #3b4047;
    background: #171b21 78%;
    margin-top: 1;
}

.workboard-section.muted {
    border: round #303236;
    background: #17191d 58%;
}

.workboard-section-title {
    color: #dfe4ea;
    text-style: bold;
    margin-bottom: 1;
}

.workboard-section.summary .workboard-section-title {
    color: #b7c8e1;
}

.workboard-section.execution .workboard-section-title {
    color: #4edea3;
}

.workboard-section.planning .workboard-section-title {
    color: #c6c6cd;
}

.workboard-section.plan .workboard-section-title {
    color: #b7c8e1;
}

.workboard-section Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.workboard-section.plan MarkdownFence {
    background: #0e0e10;
    border: round #303236;
}

.workboard-empty {
    color: #8c93a1;
}

.plan-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.plan-body MarkdownFence {
    background: #0e0e10;
    border: round #303236;
}

.block.plan.plan-ready {
    margin-top: 1;
    margin-bottom: 2;
}

.block.plan.plan-ready .card-title {
    margin-bottom: 1;
}

.plan-ready-body {
    color: #dfe4ea;
    margin-top: 0;
    margin-bottom: 1;
}

.block.plan.plan-question .card-title {
    margin-bottom: 1;
}

.block.plan.plan-question {
    height: auto;
    min-height: 0;
}

.plan-question-prompt {
    color: #dfe4ea;
    margin-top: 0;
    margin-bottom: 1;
}

.plan-question-options {
    layout: vertical;
    height: auto;
    min-height: 0;
    margin-top: 1;
    margin-bottom: 1;
}

.plan-question-option {
    margin-bottom: 1;
    border: none;
    background: #2a2a2c;
    color: #edf1f7;
    text-style: bold;
}

.plan-question-option:hover {
    background: #313337;
}

.plan-question-option.-primary,
.plan-question-option.selected {
    background: #4edea3;
    color: #07140f;
}

.plan-question-option.-primary:hover,
.plan-question-option.selected:hover {
    background: #6ae7b5;
}

.plan-question-custom-row {
    height: auto;
    min-height: 1;
    margin-top: 0;
    margin-bottom: 1;
}

#pq-custom-input {
    width: 1fr;
    margin-right: 1;
}

#pq-custom-submit {
    border: none;
    background: #2a2a2c;
    color: #edf1f7;
    text-style: bold;
}

#pq-custom-submit:hover {
    background: #313337;
}

.plan-question-status {
    margin-top: 1;
    color: #c6c6cd;
    text-style: bold;
}

.plan-ready-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
}

.plan-ready-actions Button {
    height: 1;
    min-height: 1;
    border: none;
    text-style: bold;
    padding: 0 1;
}

#plan-ready-keep {
    background: #2a2a2c;
    color: #edf1f7;
    margin-right: 1;
}

#plan-ready-keep:hover {
    background: #313337;
}

#plan-ready-implement {
    background: #4edea3;
    color: #07140f;
}

#plan-ready-implement:hover {
    background: #6ae7b5;
}

.block.tool.running {
    border: none;
    background: #181a1d 94%;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.success {
    border: none;
    background: #181a1d 94%;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.tool.error {
    border: none;
    background: #211b18 94%;
    padding: 0 1;
    margin-top: 0;
    margin-bottom: 2;
}

.block.assistant {
    margin-top: 1;
}


.card-body {
    margin-top: 1;
}

.user-body Markdown,
.assistant-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.user-body MarkdownBlock:last-of-type,
.assistant-body MarkdownBlock:last-of-type {
    margin-bottom: 0;
}

.assistant-body MarkdownFence {
    background: #0e0e10;
    border: round #303236;
}

.modal {
    width: 72;
    height: auto;
    border: round #303236;
    background: #1c1b1d 96%;
    padding: 1 2;
}

ConfirmModal,
CommitModal,
PushReviewModal,
RemoteSetupModal,
PlanQuestionModal,
SessionResumeModal,
BranchPickerModal,
AttachPickerModal,
SetupModal {
    align: center middle;
    background: #050607 62%;
}

ConfirmModal .confirm-modal {
    width: 76;
    height: 12;
    min-height: 12;
    max-height: 16;
    border: heavy #303236;
    background: #1c1b1d 96%;
    padding: 1 2;
    overflow: hidden;
}

ConfirmModal .confirm-body {
    height: 1fr;
    margin-bottom: 1;
    color: #dfe4ea;
}

ConfirmModal .confirm-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
    margin-bottom: 0;
}

ConfirmModal #yes {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: #4edea3;
    color: #07140f;
    border: none;
}

ConfirmModal #yes:hover {
    background: #6ae7b5;
}

ConfirmModal #no {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #2a2a2c;
    color: #edf1f7;
    border: none;
}

ConfirmModal #no:hover {
    background: #313337;
}

CommitModal .commit-modal {
    width: 82;
    height: 20;
    min-height: 20;
    max-height: 20;
    border: heavy #303236;
    background: #1c1b1d 96%;
    padding: 1 2;
    overflow: hidden;
}

CommitModal .commit-body {
    height: 1fr;
    min-height: 12;
}

CommitModal .commit-summary-row,
CommitModal .commit-toggle-row {
    height: 2;
    align-vertical: middle;
}

CommitModal .commit-label {
    width: 18;
    min-width: 18;
    color: #c6c6cd;
    text-style: bold;
}

CommitModal .commit-branch {
    color: #edf1f7;
    text-style: bold;
}

CommitModal .commit-stats {
    align-vertical: middle;
}

CommitModal .commit-toggle-choice {
    width: auto;
    min-width: 8;
    content-align: left middle;
}

CommitModal .commit-message-label {
    margin-top: 1;
    margin-bottom: 0;
}

CommitModal .commit-message-row {
    height: auto;
    min-height: 3;
    align-vertical: middle;
}

CommitModal #commit-message {
    width: 1fr;
    margin-bottom: 0;
    height: 3;
    min-height: 3;
    padding: 0 1;
    margin-top: 0;
    margin-right: 1;
}

CommitModal #commit-ai-fill {
    width: 3;
    min-width: 3;
    height: 3;
    min-height: 3;
    margin-left: 0;
    border: none;
    background: #27323b;
    color: #b7c8e1;
    text-style: bold;
    content-align: center middle;
}

CommitModal #commit-ai-fill:hover {
    background: #313d48;
    color: #d7e3f2;
}

CommitModal .commit-actions {
    height: 1;
    min-height: 1;
    align-horizontal: right;
    border-top: none;
    padding-top: 0;
    margin-top: 0;
}

CommitModal #commit-confirm {
    width: 14;
    min-width: 14;
    text-style: bold;
    background: #b7c8e1;
    color: #111821;
    border: none;
}

CommitModal #commit-confirm:hover {
    background: #cad6ea;
}

CommitModal #commit-push {
    width: 18;
    min-width: 18;
    text-style: bold;
    background: #4edea3;
    color: #07140f;
    border: none;
}

CommitModal #commit-push:hover {
    background: #6ae7b5;
}

CommitModal #cancel {
    width: 12;
    min-width: 12;
    text-style: bold;
    background: #2a2a2c;
    color: #edf1f7;
    border: none;
}

CommitModal #cancel:hover {
    background: #313337;
}

PushReviewModal .push-review-modal {
    width: 88;
    height: auto;
    min-height: 12;
    max-height: 16;
    border: heavy #303236;
    background: #1c1b1d 96%;
    padding: 1 2;
    overflow: hidden;
}

PushReviewModal .push-review-body {
    height: auto;
    min-height: 6;
    margin-bottom: 1;
}

PushReviewModal .push-review-row {
    height: 2;
    align-vertical: middle;
}

PushReviewModal .push-review-label {
    width: 14;
    min-width: 14;
    color: #c6c6cd;
    text-style: bold;
}

PushReviewModal .push-review-value {
    color: #edf1f7;
    text-style: bold;
}

PushReviewModal .push-review-warning {
