Screen {
    layout: vertical;
    background: #0f1115;
}

#shell {
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 4;
    padding: 1 2 0 2;
    background: #111318;
    border-bottom: solid #252a33;
}

#title {
    width: auto;
    text-style: bold;
    color: #f5f5f5;
}

#run-state {
    width: 10;
    text-align: center;
    color: #8f95a1;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #8f95a1;
}

#chat-panel {
    height: 1fr;
}

#conversation {
    height: 1fr;
    padding: 1 4 0 4;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    padding-bottom: 3;
    text-style: bold;
    text-align: center;
    text-wrap: nowrap;
    overflow: hidden;
    padding-left: 2;
    padding-right: 2;
    padding-top: 1;
    padding-bottom: 4;
}

#composer {
    height: 8;
    border: none;
    background: transparent;
    padding: 0 4 0 4;
    align-vertical: bottom;
}

#prompt-container {
    width: 1fr;
    height: auto;
    layout: vertical;
    border: round #2f3b52;
    background: #121826 88%;
    padding: 0 1 0 1;
    margin: 0 1 0 1;
}

.block {
    margin: 0 0 1 0;
    padding: 0;
    border: none;
    background: transparent;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: #9caecb;
    text-style: bold;
    margin-bottom: 0;
}

.block.user {
    border: none;
    border-left: solid #4a89d8;
    background: #121a2a 58%;
    padding: 1 2;
    margin-top: 1;
}

.block.assistant {
    border: none;
    background: transparent;
    padding: 0;
    margin: 0 0 2 0;
}

.block.assistant .card-title {
    display: none;
}

.block.assistant .card-body {
    margin-top: 0;
    padding: 0 1 0 1;
}

.block.system {
    border: solid #3a424f;
    background: #141922;
}

.block.system.error,
.block.error {
    border: solid #7f1d1d;
    background: #2a1515;
}

.block.tool.running {
    border: none;
    border-left: solid #2a6edb;
    background: #10182a 60%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.success {
    border: none;
    border-left: solid #2f9e63;
    background: #0f1d1a 52%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.tool.error {
    border: none;
    border-left: solid #b23a3a;
    background: #241516 58%;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.block.assistant {
    margin-top: 1;
}

.card-body {
    margin-top: 1;
}

.user-body Markdown,
.assistant-body Markdown {
    layout: stream;
    margin: 0;
    padding: 0;
}

.user-body MarkdownBlock:last-of-type,
.assistant-body MarkdownBlock:last-of-type {
    margin-bottom: 0;
}

.assistant-body MarkdownFence {
    background: #111a26;
    border: round #2b3a4f;
}

.modal {
    width: 72;
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #f5f5f5;
    margin-bottom: 1;
}

.modal-body {
    color: #d1d5db;
    margin-bottom: 1;
}

.modal-options {
    margin-bottom: 1;
}

.modal-list {
    height: 16;
    margin-top: 1;
    margin-bottom: 1;
    border: solid #334155;
    padding: 1;
}

.modal-actions {
    align-horizontal: right;
    margin-top: 1;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 2;
    border: none;
    background: transparent;
    color: #e5e7eb;
    padding: 1 1 0 1;
}

#prompt:focus {
    border: none;
}

#composer-gap {
    height: 1;
}

#composer-meta {
    height: 3;
    width: 1fr;
    margin: 0 0 0 0;
    align-vertical: middle;
}

.meta-icon {
    width: auto;
    color: #9ca3af;
}

.meta-chip {
    width: auto;
    margin-left: 2;
    color: #d1d5db;
    text-style: bold;
}

#composer-meta .meta-chip:last-of-type {
    margin-right: 2;
}

#meta-spacer {
    width: 1fr;
}

#send {
    width: 9;
    min-width: 9;
    height: 3;
    border: round #e5e7eb;
    background: #ffffff;
    color: #000000;
    text-style: bold;
    margin-right: 1;
    content-align: center middle;
    text-opacity: 100%;
}

#send:hover {
    background: #ffffff;
    color: #000000;
}

#send:focus {
    background: #ffffff;
    color: #000000;
}

Markdown {
    layout: stream;
    background: transparent;
}

MarkdownFence {
    background: #141a24;
    border: round #2f3a4c;
    padding: 0 1;
}

MarkdownTable {
    border: solid #2f3a4c;
}

MarkdownBlockQuote {
    border-left: solid #3f5473;
    background: #151b26;
    padding: 0 1;
}
