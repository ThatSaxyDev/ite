    align-horizontal: right;
    margin-top: 1;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 2;
    border: none;
    background: transparent;
    color: #edf1f7;
    padding: 1 1 0 1;
}

#prompt:focus {
    border: none;
}

#composer-gap {
    height: 1;
}

#command-palette {
    display: none;
    height: auto;
    min-height: 1;
    width: 1fr;
    margin: 0 2 0 2;
    padding: 0 1 0 1;
    border: round #303236;
    background: #24282c 94%;
    color: #edf1f7;
    pointer: pointer;
}

#composer-meta-line {
    height: 1;
    min-height: 1;
    width: 1fr;
    margin: 0 2 0 2;
    color: #c6c6cd;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

