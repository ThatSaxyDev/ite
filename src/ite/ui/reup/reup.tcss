Screen {
    layout: vertical;
    background: #0f1115;
}

#shell {
    height: 1fr;
    layout: vertical;
}

#topbar {
    height: 3;
    padding: 0 2 0 2;
    background: #111318;
    border-bottom: solid #252a33;
}

#title {
    width: auto;
    text-style: bold;
    color: #f5f5f5;
}

#run-state {
    width: 10;
    text-align: center;
    color: #8f95a1;
}

#header-meta {
    width: 1fr;
    text-align: right;
    color: #8f95a1;
}

#chat-panel {
    height: 1fr;
}

#conversation {
    height: 1fr;
    padding: 1 4 1 4;
}

#empty-state {
    width: 100%;
    height: 100%;
    content-align: center middle;
    text-align: center;
    layer: overlay;
    layers: overlay;
    dock: top;
    background: transparent;
    padding-bottom: 3;
    text-style: bold;
    text-align: center;
    text-wrap: nowrap;
    overflow: hidden;
    padding-left: 2;
    padding-right: 2;
    padding-top: 1;
    padding-bottom: 4;
}

#composer {
    height: 11;
    border-top: solid #252a33;
    background: #101319;
    padding: 1 4 1 4;
}

#prompt-container {
    width: 1fr;
    height: 100%;
    border: round #2d333d;
    background: #171a21;
    padding: 0 1 0 1;
}

.block {
    margin: 0 0 1 0;
    padding: 1;
    border: solid #2b313c;
    background: #161b22;
    height: auto;
    max-width: 180;
}

.block .card-title {
    color: #9ecbff;
    text-style: bold;
    margin-bottom: 1;
}

.block.user {
    border: solid #313948;
    background: #1b2028;
}

.block.assistant {
    border: solid #2f4863;
}

.block.system {
    border: solid #3a424f;
    background: #141922;
}

.block.system.error,
.block.error {
    border: solid #7f1d1d;
    background: #2a1515;
}

.block.tool.running {
    border: solid #1d4ed8;
}

.block.success {
    border: solid #166534;
}

.modal {
    width: 72;
    height: auto;
    border: round #334155;
    background: #111827;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #f5f5f5;
    margin-bottom: 1;
}

.modal-body {
    color: #d1d5db;
    margin-bottom: 1;
}

.modal-options {
    margin-bottom: 1;
}

.modal-list {
    height: 16;
    margin-top: 1;
    margin-bottom: 1;
    border: solid #334155;
    padding: 1;
}

.modal-actions {
    align-horizontal: right;
    margin-top: 1;
}

#prompt {
    width: 1fr;
    height: 5;
    border: none;
    background: transparent;
    color: #e5e7eb;
    padding: 0 1;
}

#prompt:focus {
    border: none;
}

#composer-meta {
    height: 1;
    width: 1fr;
    margin: 0 0 0 1;
}

.meta-icon {
    width: auto;
    color: #9ca3af;
}

.meta-chip {
    width: auto;
    margin-left: 2;
    color: #d1d5db;
    text-style: bold;
}

#composer-meta .meta-chip:last-of-type {
    margin-right: 2;
}

#meta-spacer {
    width: 1fr;
}

#send {
    width: 9;
    min-width: 9;
    height: 3;
    border: round #e5e7eb;
    background: #ffffff;
    color: #000000;
    text-style: bold;
    margin-right: 1;
    content-align: center middle;
    text-opacity: 100%;
}

#send:hover {
    background: #ffffff;
    color: #000000;
}

#send:focus {
    background: #ffffff;
    color: #000000;
}
