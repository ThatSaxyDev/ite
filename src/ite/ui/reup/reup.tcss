    align-horizontal: right;
    margin-top: 1;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 2;
    border: none;
    background: transparent;
    color: #e5e7eb;
    padding: 1 1 0 1;
}

#prompt:focus {
    border: none;
}

#composer-gap {
    height: 1;
}

#command-palette {
    display: none;
    height: auto;
    min-height: 1;
    width: 1fr;
    margin: 0 2 0 2;
    padding: 0 1 0 1;
    border: round #315b8a;
    background: #0e1726 96%;
    color: #dbe4f2;
    pointer: pointer;
}

#composer-meta-line {
    height: 1;
    min-height: 1;
    width: 1fr;
    margin: 0 2 0 2;
    color: #d1d5db;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    pointer: pointer;
}

Markdown {
    layout: stream;
    background: transparent;
}

MarkdownFence {
    background: #141a24;
    border: round #2f3a4c;
    padding: 0 1;
}

MarkdownTable {
    border: solid #2f3a4c;
}

MarkdownBlockQuote {
    border-left: solid #3f5473;
    background: #151b26;
    padding: 0 1;
}
