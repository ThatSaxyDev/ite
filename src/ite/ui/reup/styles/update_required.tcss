#update-required-state {
    display: none;
    width: 100%;
    height: 100%;
    align: center middle;
    background: $background;
    padding: 0;
}

#update-required-stack {
    width: 72;
    height: auto;
    max-width: 100%;
    align-horizontal: center;
    align-vertical: middle;
    padding: 0;
}

#update-required-title {
    width: 100%;
    text-style: bold;
    color: $text-warning;
    content-align: center middle;
    text-align: center;
}

#update-required-copy {
    width: 100%;
    margin-top: 1;
    color: $text-primary;
    content-align: center middle;
    text-align: center;
}

#update-command-box {
    width: 100%;
    height: 3;
    margin-top: 2;
    padding: 0 1;
    background: $surface;
    border: solid $border;
    align-vertical: middle;
}

#update-command-text {
    width: 1fr;
    height: 1;
    color: $text-primary;
    text-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

#update-command-copy {
    width: 10;
    min-width: 10;
    height: 1;
    min-height: 1;
    margin-left: 1;
    padding: 0 1;
    background: $primary-muted;
    color: $text-primary;
    border: none;
    text-style: bold;
}

#update-command-copy:hover,
#update-command-copy:focus {
    background: $primary;
    color: $background;
    border: none;
}

#update-required-meta {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: $text-secondary;
    content-align: center middle;
    text-align: center;
}

#update-required-actions {
    width: 100%;
    height: auto;
    margin-top: 2;
    align-horizontal: center;
    align-vertical: middle;
}

#update-required-exit {
    width: 18;
    min-width: 18;
    height: 3;
    padding: 0 2;
    background: $panel;
    color: $foreground;
    border: none;
    text-style: bold;
    content-align: center middle;
}

#update-required-exit:hover,
#update-required-exit:focus {
    background: $panel-lighten-1;
    color: $foreground;
    border: none;
}

CopyableCodeBlock > .code-header > .copy-button {
    min-width: 0;
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $foreground-muted;
    border: none;
    text-style: none;
    opacity: 0.6;
    transition: opacity 0.15s, color 0.15s;
}

CopyableCodeBlock:hover > .code-header > .copy-button {
    opacity: 1;
    color: $foreground;
}

CopyableCodeBlock > .code-header > .copy-button:hover {
    background: $panel;
    color: $text-primary;
    opacity: 1;
}

CopyableCodeBlock > .code-header > .copy-button:focus {
    background: $panel-lighten-1;
    color: $text-primary;
    opacity: 1;
    text-style: none;
}

CopyableMarkdown {
    layout: stream;
    background: transparent;
}
